{
  "name": "course-queue",
  "version": "0.3.10",
  "private": true,
  "type": "module",
  "description": "课序 · 在学习通网页接续视频、教材和下一小节。",
  "license": "MIT",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26"
  },
  "scripts": {
