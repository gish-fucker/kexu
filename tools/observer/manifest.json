{
  "manifest_version": 3,
  "name": "课序诊断",
  "description": "在所选学习通标签页记录阅读器和任务点的状态变化。",
  "version": "1.0.0",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "课序诊断",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.chaoxing.com/*/mycourse/studentstudy*",
        "https://*.chaoxing.com/mycourse/studentstudy*",
        "https://*.chaoxing.com/*/knowledge/cards*",
        "https://*.chaoxing.com/knowledge/cards*",
        "https://*.chaoxing.com/ananas/modules/*",
        "https://pan-yz.chaoxing.com/screen/v2/*"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "js": [
        "observe.js"
      ]
    }
  ]
}